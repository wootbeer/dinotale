+float3 HqColorspace(float3 rgb) {
+    return float3(0.250f * rgb.r + 0.250f * rgb.g + 0.250f * rgb.b,
+                  0.250f * rgb.r - 0.000f * rgb.g - 0.250f * rgb.b,
+                  -0.125f * rgb.r + 0.250f * rgb.g - 0.125f * rgb.b);
+}
+
+bool HqDifferent(float3 a, float3 b) {
+    float3 diff = abs(HqColorspace(a) - HqColorspace(b));
+    return diff.x > 0.188f || diff.y > 0.027f || diff.z > 0.031f;
+}
+
+float3 HqInterp2(float3 c1, float w1, float3 c2, float w2) { return (c1 * w1 + c2 * w2) / (w1 + w2); }
+float3 HqInterp3(float3 c1, float w1, float3 c2, float w2, float3 c3, float w3) { return (c1 * w1 + c2 * w2 + c3 * w3) / (w1 + w2 + w3); }
+
+float3 FilterHq2x(float2 srcPos) {
+    float2 cell = floor(srcPos);
+    float2 p = srcPos - cell;
+    // Always the top left quarter; other quarters flip the neighbourhood.
+    float2 o = float2((p.x > 0.5f) ? -1.0f : 1.0f, (p.y > 0.5f) ? -1.0f : 1.0f);
+    float3 w0 = SourcePixel(cell, float2(-o.x, -o.y));
+    float3 w1 = SourcePixel(cell, float2(0.0f, -o.y));
+    float3 w2 = SourcePixel(cell, float2(o.x, -o.y));
+    float3 w3 = SourcePixel(cell, float2(-o.x, 0.0f));
+    float3 w4 = SourcePixel(cell, float2(0.0f, 0.0f));
+    float3 w5 = SourcePixel(cell, float2(o.x, 0.0f));
+    float3 w6 = SourcePixel(cell, float2(-o.x, o.y));
+    float3 w7 = SourcePixel(cell, float2(0.0f, o.y));
+    float3 w8 = SourcePixel(cell, float2(o.x, o.y));
+
+    uint pattern = 0;
+    if (HqDifferent(w0, w4)) pattern |= 1;
+    if (HqDifferent(w1, w4)) pattern |= 2;
+    if (HqDifferent(w2, w4)) pattern |= 4;
+    if (HqDifferent(w3, w4)) pattern |= 8;
+    if (HqDifferent(w5, w4)) pattern |= 16;
+    if (HqDifferent(w6, w4)) pattern |= 32;
+    if (HqDifferent(w7, w4)) pattern |= 64;
+    if (HqDifferent(w8, w4)) pattern |= 128;
+#define HQP(m, r) ((pattern & (m)) == (r))
+    if ((HQP(0xbf, 0x37) || HQP(0xdb, 0x13)) && HqDifferent(w1, w5))
+        return HqInterp2(w4, 3.0f, w3, 1.0f);
+    if ((HQP(0xdb, 0x49) || HQP(0xef, 0x6d)) && HqDifferent(w7, w3))
+        return HqInterp2(w4, 3.0f, w1, 1.0f);
+    if ((HQP(0x0b, 0x0b) || HQP(0xfe, 0x4a) || HQP(0xfe, 0x1a)) && HqDifferent(w3, w1))
+        return w4;
+    if ((HQP(0x6f, 0x2a) || HQP(0x5b, 0x0a) || HQP(0xbf, 0x3a) || HQP(0xdf, 0x5a) ||
+         HQP(0x9f, 0x8a) || HQP(0xcf, 0x8a) || HQP(0xef, 0x4e) || HQP(0x3f, 0x0e) ||
+         HQP(0xfb, 0x5a) || HQP(0xbb, 0x8a) || HQP(0x7f, 0x5a) || HQP(0xaf, 0x8a) ||
+         HQP(0xeb, 0x8a)) && HqDifferent(w3, w1))
+        return HqInterp2(w4, 3.0f, w0, 1.0f);
+    if (HQP(0x0b, 0x08))
+        return HqInterp3(w4, 2.0f, w0, 1.0f, w1, 1.0f);
+    if (HQP(0x0b, 0x02))
+        return HqInterp3(w4, 2.0f, w0, 1.0f, w3, 1.0f);
+    if (HQP(0x2f, 0x2f))
+        return HqInterp3(w4, 1.04f, w3, 1.0f, w1, 1.0f);
+    if (HQP(0xbf, 0x37) || HQP(0xdb, 0x13))
+        return HqInterp3(w4, 5.0f, w1, 2.0f, w3, 1.0f);
+    if (HQP(0xdb, 0x49) || HQP(0xef, 0x6d))
+        return HqInterp3(w4, 5.0f, w3, 2.0f, w1, 1.0f);
+    if (HQP(0x1b, 0x03) || HQP(0x4f, 0x43) || HQP(0x8b, 0x83) || HQP(0x6b, 0x43))
+        return HqInterp2(w4, 3.0f, w3, 1.0f);
+    if (HQP(0x4b, 0x09) || HQP(0x8b, 0x89) || HQP(0x1f, 0x19) || HQP(0x3b, 0x19))
+        return HqInterp2(w4, 3.0f, w1, 1.0f);
+    if (HQP(0x7e, 0x2a) || HQP(0xef, 0xab) || HQP(0xbf, 0x8f) || HQP(0x7e, 0x0e))
+        return HqInterp3(w4, 2.0f, w3, 3.0f, w1, 3.0f);
+    if (HQP(0xfb, 0x6a) || HQP(0x6f, 0x6e) || HQP(0x3f, 0x3e) || HQP(0xfb, 0xfa) ||
+        HQP(0xdf, 0xde) || HQP(0xdf, 0x1e))
+        return HqInterp2(w4, 3.0f, w0, 1.0f);
+    if (HQP(0x0a, 0x00) || HQP(0x4f, 0x4b) || HQP(0x9f, 0x1b) || HQP(0x2f, 0x0b) ||
+        HQP(0xbe, 0x0a) || HQP(0xee, 0x0a) || HQP(0x7e, 0x0a) || HQP(0xeb, 0x4b) ||
+        HQP(0x3b, 0x1b))
+        return HqInterp3(w4, 2.0f, w3, 1.0f, w1, 1.0f);
+#undef HQP
+    return HqInterp3(w4, 6.0f, w3, 1.0f, w1, 1.0f);
+}
+
+float4 ApplyScreenFilter(float2 uv, float2 screenPos) {
+    float2 srcPos = uv * gConstants.sourceResolution;
+    float3 color;
+    switch (gConstants.screenFilter) {
+    case 1: color = FilterCrt(srcPos, screenPos); break;
+    case 2: color = FilterScanlines(srcPos); break;
+    case 3: color = FilterLcd(srcPos); break;
+    case 4: color = FilterXbr(srcPos); break;
+    case 5: color = FilterXbrz(srcPos); break;
+    default: color = FilterHq2x(srcPos); break;
+    }
+
+    return float4(color, 1.0f);
+}
+
 float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
+    if (gConstants.screenFilter != 0) {
+        return ApplyScreenFilter(uv, pos.xy);
+    }
+
 #ifdef PIXEL_ANTIALIASING
     return PixelAntialiasing(uv);
 #else
