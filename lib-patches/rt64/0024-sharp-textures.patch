diff --git a/src/render/rt64_vi_renderer.cpp b/src/render/rt64_vi_renderer.cpp
--- a/src/render/rt64_vi_renderer.cpp
+++ b/src/render/rt64_vi_renderer.cpp
@@ -36,6 +36,16 @@
         return hybridSideBrightness.load(std::memory_order_relaxed);
     }
 
+    static std::atomic<bool> sharpTextures{ false };
+
+    void setSharpTextures(bool sharp) {
+        sharpTextures.store(sharp, std::memory_order_relaxed);
+    }
+
+    bool getSharpTextures() {
+        return sharpTextures.load(std::memory_order_relaxed);
+    }
+
     // VIRenderer
 
     VIRenderer::VIRenderer() { }
