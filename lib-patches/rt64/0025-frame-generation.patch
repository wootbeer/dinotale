+    bool PresentQueue::threadPresentGenerated(const Present &present, RenderTarget *colorTarget, UserConfiguration::Filtering filtering, bool removeBlackBorders, bool stretchToWindow, bool dimSides, bool &lockedWorkloadMutex, bool &swapChainValid) {
+        const bool vulkan = (ext.createdGraphicsAPI == UserConfiguration::GraphicsAPI::Vulkan);
+        if (!frameGeneration.prepare(ext.device, ext.swapChain, vulkan)) {
+            return false;
+        }
+
+        // 1. Draw the game frame into the generator's source image, take it in and generate.
+        RenderCommandList *commandList = ext.presentGraphicsWorker->commandList.get();
+        RenderTexture *sourceTexture = frameGeneration.sourceTexture();
+        commandList->begin();
+        commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(sourceTexture, RenderTextureLayout::COLOR_WRITE));
+
+        VIRenderer::RenderParams renderParams;
+        renderParams.device = ext.device;
+        renderParams.commandList = commandList;
+        renderParams.swapChain = ext.swapChain;
+        renderParams.shaderLibrary = ext.shaderLibrary;
+        renderParams.textureFormat = colorTarget->format;
+        renderParams.resolutionScale = colorTarget->resolutionScale;
+        renderParams.downsamplingScale = 1;
+        renderParams.filtering = filtering;
+        renderParams.vi = &present.screenVI;
+        renderParams.removeBlackBorders = removeBlackBorders;
+        renderParams.stretchToWindow = stretchToWindow;
+        renderParams.dimSides = dimSides;
+        if (colorTarget->downsampleMultiplier > 1) {
+            colorTarget->downsampleTarget(ext.presentGraphicsWorker, ext.shaderLibrary);
+            renderParams.texture = colorTarget->downsampledTexture.get();
+            renderParams.textureWidth = colorTarget->width / colorTarget->downsampleMultiplier;
+            renderParams.textureHeight = colorTarget->height / colorTarget->downsampleMultiplier;
+            renderParams.downsamplingScale = colorTarget->downsampleMultiplier;
+        }
+        else {
+            colorTarget->resolveTarget(ext.presentGraphicsWorker, ext.shaderLibrary);
+            renderParams.texture = colorTarget->getResolvedTexture();
+            renderParams.textureWidth = colorTarget->width;
+            renderParams.textureHeight = colorTarget->height;
+        }
+
+        commandList->setFramebuffer(frameGeneration.sourceFramebuffer());
+        commandList->clearColor();
+        if (renderParams.texture != nullptr) {
+            commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(renderParams.texture, RenderTextureLayout::SHADER_READ));
+            viRenderer->render(renderParams);
+        }
+
+        commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(sourceTexture, RenderTextureLayout::COPY_SOURCE));
+        uint32_t generatedFrames = frameGeneration.record(commandList);
+        commandList->end();
+        ext.presentGraphicsWorker->execute();
+        ext.presentGraphicsWorker->wait();
+
+        // A cut to another picture: the frames generated across it would morph one into the other.
+        if (frameGeneration.sceneCut()) {
+            generatedFrames = 0;
+        }
+
+        // The game frame is in the source image now: the workload can go on while the frames are presented.
+        if (lockedWorkloadMutex) {
+            ext.sharedResources->workloadMutex.unlock();
+            lockedWorkloadMutex = false;
+        }
+
+        notifyPresentId(present);
+
+        // 2. The generated frames, then the game frame, spaced evenly over the game frame interval.
+        const std::chrono::nanoseconds spacing = frameGeneration.markGameFrame(generatedFrames + 1);
+
+        // Paced by the display's refreshes where present wait can count them: the game frame interval
+        // in whole refreshes, split evenly, each frame presented again for each refresh of its share.
+        // Timed presents land on whichever refresh comes next, so one near a refresh's edge stays up a
+        // refresh more or less than the others, and a pan judders. Otherwise, timed.
+        const uint32_t frameCount = generatedFrames + 1;
+        const uint32_t refreshRate = ext.sharedResources->swapChainRate;
+        uint32_t refreshes = 0;
+        if (presentWaitEnabled && (refreshRate > 0) && (refreshRate < 1000) && (spacing.count() > 0)) {
+            refreshes = uint32_t(std::lround(double(spacing.count()) * frameCount * refreshRate / 1e9));
+            if (refreshes < frameCount) {
+                refreshes = 0;
+            }
+        }
+
+        auto newerPresentWaiting = [&]() {
+            std::unique_lock<std::mutex> cursorLock(cursorMutex);
+            return writeCursor != threadCursor;
+        };
+
+        Timestamp firstPresent;
+        uint32_t presentIndex = 0;
+        for (uint32_t f = 0; (f < frameCount) && swapChainValid; f++) {
+            const uint32_t repeats = (refreshes > 0) ? ((f + 1) * refreshes / frameCount - f * refreshes / frameCount) : 1;
+            for (uint32_t r = 0; (r < repeats) && swapChainValid; r++, presentIndex++) {
+                if (refreshes == 0) {
+                    if ((f > 0) && (spacing.count() > 0)) {
+                        Timer::preciseSleepUntil(firstPresent + spacing * f);
+                    }
+                }
+                // A newer game frame is waiting: the game frame's remaining refreshes would only add delay.
+                else if ((f == frameCount - 1) && (r > 0) && newerPresentWaiting()) {
+                    break;
+                }
+
+                uint32_t swapChainIndex = 0;
+                swapChainValid = ext.swapChain->acquireTexture(acquiredSemaphore.get(), &swapChainIndex);
+                if (!swapChainValid) {
+                    break;
+                }
+
+                RenderTexture *swapChainTexture = ext.swapChain->getTexture(swapChainIndex);
+                RenderFramebuffer *swapChainFramebuffer = swapChainFramebuffers[swapChainIndex].get();
+                commandList->begin();
+                commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(swapChainTexture, RenderTextureLayout::COPY_DEST));
+                if (f < generatedFrames) {
+                    frameGeneration.recordOutput(commandList, f, swapChainTexture);
+                }
+                else {
+                    commandList->copyTexture(swapChainTexture, sourceTexture);
+                }
+
+                commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(swapChainTexture, RenderTextureLayout::COLOR_WRITE));
+                commandList->setFramebuffer(swapChainFramebuffer);
+
+                RenderHookDraw *drawHook = GetRenderHookDraw();
+                if (drawHook != nullptr) {
+                    drawHook(commandList, swapChainFramebuffer);
+                }
+
+                {
+                    const std::scoped_lock lock(inspectorMutex);
+                    if (inspector != nullptr) {
+                        inspector->draw(commandList);
+                    }
+                }
+
+                commandList->barriers(RenderBarrierStage::NONE, RenderTextureBarrier(swapChainTexture, RenderTextureLayout::PRESENT));
+                commandList->end();
+                const RenderCommandList *constCommandList = commandList;
+                RenderCommandSemaphore *waitSemaphore = acquiredSemaphore.get();
+                RenderCommandSemaphore *signalSemaphore = drawSemaphores[swapChainIndex].get();
+                ext.presentGraphicsWorker->commandQueue->executeCommandLists(&constCommandList, 1, &waitSemaphore, 1, &signalSemaphore, 1, ext.presentGraphicsWorker->commandFence.get());
+                ext.presentGraphicsWorker->wait();
+
+                if (refreshes > 0) {
+                    // Until the last present is on screen: one present per refresh.
+                    ext.swapChain->wait();
+                }
+
+                presentTimestamp = Timer::current();
+                if (presentIndex == 0) {
+                    firstPresent = presentTimestamp;
+                }
+
+                swapChainValid = ext.swapChain->present(swapChainIndex, &signalSemaphore, 1);
+                presentProfiler.logAndRestart();
+            }
+        }
+
+        return true;
+    }
+
     void PresentQueue::skipInterpolation() {
         {
             std::unique_lock<std::mutex> interpolatedLock(ext.sharedResources->interpolatedMutex);
@@ -550,5 +723,8 @@
             ext.presentGraphicsWorker->commandQueue->executeCommandLists(&commandList, 1, &waitSemaphore, 1, nullptr, 0, ext.presentGraphicsWorker->commandFence.get());
             ext.presentGraphicsWorker->wait();
         }
+
+        // The present worker is idle here: the frame generator can go.
+        frameGeneration.release();
     }
