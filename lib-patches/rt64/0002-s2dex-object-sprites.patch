+        // --- Sprite objects (uObjSprite) -----------------------------------------
+        // The S2D struct buffer holds RDRAM's 32-bit words in host order, so the
+        // N64's big-endian fields are read through these instead of a packed struct.
+        static uint32_t s2dWord(const uint8_t *buf, uint32_t offset) {
+            uint32_t word;
+            memcpy(&word, buf + (offset & ~3U), sizeof(word));
+            return word;
+        }
+
+        static uint16_t s2dHalf(const uint8_t *buf, uint32_t offset) {
+            const uint32_t word = s2dWord(buf, offset);
+            return (offset & 2) ? uint16_t(word & 0xFFFF) : uint16_t(word >> 16);
+        }
+
+        static uint8_t s2dByte(const uint8_t *buf, uint32_t offset) {
+            const uint32_t word = s2dWord(buf, offset);
+            return uint8_t(word >> (24 - 8 * (offset & 3)));
+        }
+
+        struct ObjSprite {
+            float objX, objY;     // s10.2
+            float scaleW, scaleH; // u5.10
+            float imageW, imageH; // u10.5, in texels
+            uint16_t imageStride; // In 64-bit words.
+            uint16_t imageAdrs;   // TMEM address in 64-bit words.
+            uint8_t imageFmt, imageSiz, imagePal, imageFlags;
+        };
+
+        // Reads a uObjSprite (24 bytes) at the given offset of the struct buffer.
+        static ObjSprite readObjSprite(const uint8_t *buf, uint32_t base) {
+            ObjSprite o;
+            o.objX = int16_t(s2dHalf(buf, base + 0)) / 4.0f;
+            o.scaleW = s2dHalf(buf, base + 2) / 1024.0f;
+            o.imageW = s2dHalf(buf, base + 4) / 32.0f;
+            o.objY = int16_t(s2dHalf(buf, base + 8)) / 4.0f;
+            o.scaleH = s2dHalf(buf, base + 10) / 1024.0f;
+            o.imageH = s2dHalf(buf, base + 12) / 32.0f;
+            o.imageStride = s2dHalf(buf, base + 16);
+            o.imageAdrs = s2dHalf(buf, base + 18);
+            o.imageFmt = s2dByte(buf, base + 20);
+            o.imageSiz = s2dByte(buf, base + 21);
+            o.imagePal = s2dByte(buf, base + 22);
+            o.imageFlags = s2dByte(buf, base + 23);
+            if (o.scaleW <= 0.0f) o.scaleW = 1.0f;
+            if (o.scaleH <= 0.0f) o.scaleH = 1.0f;
+            return o;
+        }
+
+        // Draws a sprite's texture over the screen rectangle (x0, y0)-(x1, y1), in
+        // pixels. Mirrored axes (x1 < x0 or y1 < y0) flip the texture, as do the
+        // sprite's own flip flags. The render tile is set up the way the S2DEX
+        // microcode does it before drawing.
+        static void drawObjRect(State *state, const ObjSprite &o, float x0, float y0, float x1, float y1) {
+            RDP *rdp = state->rdp.get();
+            const uint32_t objRenderMode = state->rsp->objRenderMode;
+            const uint8_t clamp = (objRenderMode & S2DEX_G_OBJRM_NOTXCLAMP) ? (G_TX_WRAP | G_TX_NOMIRROR) : G_TX_CLAMP;
+            const int texW = std::max(int(o.imageW), 1);
+            const int texH = std::max(int(o.imageH), 1);
+            rdp->setTile(G_TX_RENDERTILE, o.imageFmt, o.imageSiz, o.imageStride, o.imageAdrs, o.imagePal, clamp, clamp, 0, 0, 0, 0);
+            rdp->setTileSize(G_TX_RENDERTILE, 0, 0, uint16_t((texW - 1) << 2), uint16_t((texH - 1) << 2));
+
+            bool flipS = (o.imageFlags & S2DEX_G_OBJ_FLAG_FLIPS) != 0;
+            bool flipT = (o.imageFlags & S2DEX_G_OBJ_FLAG_FLIPT) != 0;
+            if (x1 < x0) { std::swap(x0, x1); flipS = !flipS; }
+            if (y1 < y0) { std::swap(y0, y1); flipT = !flipT; }
+            const float width = x1 - x0;
+            const float height = y1 - y0;
+            if ((width <= 0.0f) || (height <= 0.0f)) {
+                return;
+            }
+
+            // Texels per screen pixel, as s5.10.
+            const float stepS = o.imageW / width;
+            const float stepT = o.imageH / height;
+            int16_t dsdx = int16_t(std::lround(stepS * 1024.0f));
+            int16_t dtdy = int16_t(std::lround(stepT * 1024.0f));
+            int16_t uls = 0;
+            int16_t ult = 0;
+            if (flipS) { uls = int16_t(std::lround(o.imageW * 32.0f)) - 1; dsdx = -dsdx; }
+            if (flipT) { ult = int16_t(std::lround(o.imageH * 32.0f)) - 1; dtdy = -dtdy; }
+
+            const int32_t ulx = int32_t(std::lround(x0 * 4.0f));
+            const int32_t uly = int32_t(std::lround(y0 * 4.0f));
+            const int32_t lrx = int32_t(std::lround(x1 * 4.0f));
+            const int32_t lry = int32_t(std::lround(y1 * 4.0f));
+            rdp->drawTexRect(ulx, uly, lrx, lry, G_TX_RENDERTILE, uls, ult, dsdx, dtdy, false);
+        }
+
+        // G_OBJ_RECTANGLE: the sprite unscaled by the 2D matrix, at its own position.
+        static void doObjRectangle(State *state, const ObjSprite &o) {
+            const float x0 = o.objX;
+            const float y0 = o.objY;
+            drawObjRect(state, o, x0, y0, x0 + o.imageW / o.scaleW, y0 + o.imageH / o.scaleH);
+        }
+
+        // G_OBJ_RECTANGLE_R: positioned and scaled by the 2D matrix's X, Y and base
+        // scale (no rotation).
+        static void doObjRectangleR(State *state, const ObjSprite &o) {
+            const auto &m = state->rsp->S2D.objMtx;
+            const float bsx = (m.baseScaleX > 0.0f) ? m.baseScaleX : 1.0f;
+            const float bsy = (m.baseScaleY > 0.0f) ? m.baseScaleY : 1.0f;
+            const float x0 = o.objX / bsx + m.X;
+            const float y0 = o.objY / bsy + m.Y;
+            const float x1 = (o.objX + o.imageW / o.scaleW) / bsx + m.X;
+            const float y1 = (o.objY + o.imageH / o.scaleH) / bsy + m.Y;
+            drawObjRect(state, o, x0, y0, x1, y1);
+        }
+
+        // G_OBJ_SPRITE: transformed by the full 2D matrix. Drawn as a texture
+        // rectangle, which covers scaling, mirroring and translation.
+        // TODO: rotation and shear (B, C) need the sprite drawn as two triangles;
+        // for now the rectangle is the transformed sprite's bounding box.
+        static void doObjSprite(State *state, const ObjSprite &o) {
+            const auto &m = state->rsp->S2D.objMtx;
+            const float sx0 = o.objX;
+            const float sy0 = o.objY;
+            const float sx1 = o.objX + o.imageW / o.scaleW;
+            const float sy1 = o.objY + o.imageH / o.scaleH;
+            if ((m.B == 0.0f) && (m.C == 0.0f)) {
+                drawObjRect(state, o, m.A * sx0 + m.X, m.D * sy0 + m.Y, m.A * sx1 + m.X, m.D * sy1 + m.Y);
+                return;
+            }
+
+            const float xs[4] = { m.A * sx0 + m.B * sy0, m.A * sx1 + m.B * sy0, m.A * sx0 + m.B * sy1, m.A * sx1 + m.B * sy1 };
+            const float ys[4] = { m.C * sx0 + m.D * sy0, m.C * sx1 + m.D * sy0, m.C * sx0 + m.D * sy1, m.C * sx1 + m.D * sy1 };
+            const float minX = std::min(std::min(xs[0], xs[1]), std::min(xs[2], xs[3]));
+            const float maxX = std::max(std::max(xs[0], xs[1]), std::max(xs[2], xs[3]));
+            const float minY = std::min(std::min(ys[0], ys[1]), std::min(ys[2], ys[3]));
+            const float maxY = std::max(std::max(ys[0], ys[1]), std::max(ys[2], ys[3]));
+            const bool mirrorX = (m.A < 0.0f);
+            const bool mirrorY = (m.D < 0.0f);
+            drawObjRect(state, o,
+                (mirrorX ? maxX : minX) + m.X, (mirrorY ? maxY : minY) + m.Y,
+                (mirrorX ? minX : maxX) + m.X, (mirrorY ? minY : maxY) + m.Y);
+        }
+
+        void objRectangle(State *state, DisplayList **dl) {
+            readS2DStruct(state, (*dl)->w1, 24);
+            doObjRectangle(state, readObjSprite(state->rsp->S2D.struct_buffer.data(), 0));
+        }
+
+        void objSprite(State *state, DisplayList **dl) {
+            readS2DStruct(state, (*dl)->w1, 24);
+            doObjSprite(state, readObjSprite(state->rsp->S2D.struct_buffer.data(), 0));
+        }
+
+        void objRectangleR(State *state, DisplayList **dl) {
+            readS2DStruct(state, (*dl)->w1, 24);
+            doObjRectangleR(state, readObjSprite(state->rsp->S2D.struct_buffer.data(), 0));
+        }
+
+        // G_OBJ_MOVEMEM: loads a uObjMtx (index 0, 24 bytes) or a uObjSubMtx
+        // (index 2, 8 bytes: X, Y and the base scale) into the 2D matrix.
+        void objMovemem(State *state, DisplayList **dl) {
+            const uint32_t length = (*dl)->p0(16, 8) + 1;
+            const uint32_t index = (*dl)->p0(0, 16);
+            readS2DStruct(state, (*dl)->w1, length);
+            const uint8_t *buf = state->rsp->S2D.struct_buffer.data();
+            auto &m = state->rsp->S2D.objMtx;
+            uint32_t sub = 0;
+            if (index == 0) {
+                m.A = int32_t(s2dWord(buf, 0)) / 65536.0f;
+                m.B = int32_t(s2dWord(buf, 4)) / 65536.0f;
+                m.C = int32_t(s2dWord(buf, 8)) / 65536.0f;
+                m.D = int32_t(s2dWord(buf, 12)) / 65536.0f;
+                sub = 16;
+            }
+            m.X = int16_t(s2dHalf(buf, sub + 0)) / 4.0f;
+            m.Y = int16_t(s2dHalf(buf, sub + 2)) / 4.0f;
+            m.baseScaleX = s2dHalf(buf, sub + 4) / 1024.0f;
+            m.baseScaleY = s2dHalf(buf, sub + 6) / 1024.0f;
+        }
