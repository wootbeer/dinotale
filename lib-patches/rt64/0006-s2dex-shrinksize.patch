+
+            // G_OBJRM_SHRINKSIZE_1/2 trim half a texel / one texel off every edge, so bilinear
+            // filtering never blends in texels from outside the sprite. Games that draw a large
+            // image in TMEM-sized strips overlap the strips by a texel and rely on this trim for
+            // a seamless join (Yoshi's Story's text boxes); without it each join leaves a line.
+            float shrink = 0.0f;
+            if (objRenderMode & S2DEX_G_OBJRM_SHRINKSIZE_2) {
+                shrink = 1.0f;
+            }
+            else if (objRenderMode & S2DEX_G_OBJRM_SHRINKSIZE_1) {
+                shrink = 0.5f;
+            }
+
+            if (shrink > 0.0f) {
+                const float insetX = shrink / stepS;
+                const float insetY = shrink / stepT;
+                if (((x1 - x0) <= 2.0f * insetX) || ((y1 - y0) <= 2.0f * insetY)) {
+                    return;
+                }
+
+                x0 += insetX;
+                x1 -= insetX;
+                y0 += insetY;
+                y1 -= insetY;
+            }
