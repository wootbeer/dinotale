+                quad.pos[i][1] = ys[i];
+                quad.tc[i][0] = ss[i];
+                quad.tc[i][1] = ts[i];
+            }
+
+            const int32_t ulx = int32_t(x0) * 4;
+            const int32_t uly = int32_t(y0) * 4;
+            const int32_t lrx = int32_t(x1) * 4;
+            const int32_t lry = int32_t(y1) * 4;
+
+            // The rectangle's own texture coordinates only bound the texels it samples: the whole image.
+            const int16_t rectDsdx = int16_t(std::lround(o.imageW * 4096.0f / float(lrx - ulx)));
+            const int16_t rectDtdy = int16_t(std::lround(o.imageH * 4096.0f / float(lry - uly)));
+            quad.active = true;
+            rdp->drawTexRect(ulx, uly, lrx, lry, G_TX_RENDERTILE, 0, 0, rectDsdx, rectDtdy, false);
