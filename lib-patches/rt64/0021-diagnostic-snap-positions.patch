+// DinoTale: diagnostic switch (issue #16). With DINOTALE_SNAP set, sprites and background layers are placed on
+// whole native pixels / texels, as the N64 draws them, instead of at their sub-pixel positions.
+static bool dinotaleSnapPositions() {
+    static const bool snap = (std::getenv("DINOTALE_SNAP") != nullptr);
+    return snap;
+}
