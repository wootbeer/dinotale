+};
+
+// DinoTale: see BgLeftMask. Called from the game thread.
+extern "C" void rt64_dinotale_set_bg_left_mask(uint32_t address, int32_t columns) {
+    using namespace RT64::GBI_S2DEX;
+    std::scoped_lock lock(bgLeftMaskMutex);
+    address &= 0xFFFFFF;
+    BgLeftMask *freeSlot = nullptr;
+    for (BgLeftMask &mask : bgLeftMasks) {
+        if (mask.address == address) {
+            mask.columns = columns;
+            return;
+        }
+
+        if ((freeSlot == nullptr) && ((mask.address == 0) || (mask.columns == 0))) {
+            freeSlot = &mask;
+        }
+    }
+
+    if ((freeSlot != nullptr) && (columns > 0)) {
+        freeSlot->address = address;
+        freeSlot->columns = columns;
+    }
+}
