+        // DinoTale (Expand): columns at the left of a background image that the game has no art for, by
+        // image address (set by the game hooks in src/game/widescreen.cpp, read here on the renderer's
+        // thread). After the background is drawn, that strip of the screen is filled with black.
+        struct BgLeftMask {
+            uint32_t address = 0;
+            int32_t columns = 0;
+        };
+
+        static std::mutex bgLeftMaskMutex;
+        static std::array<BgLeftMask, 8> bgLeftMasks;
+
+        static int32_t bgLeftMaskColumns(uint32_t address) {
+            std::scoped_lock lock(bgLeftMaskMutex);
+            for (const BgLeftMask &mask : bgLeftMasks) {
+                if (mask.address == (address & 0xFFFFFF)) {
+                    return mask.columns;
+                }
+            }
+
+            return 0;
+        }
+
+        struct BgLeftMaskScope {
+            State *state;
+            int32_t ulx, uly, lrx, lry;
+            BgLeftMaskScope(State *state, const uObjScaleBg_t &scaleBg) : state(state) {
+                const int32_t columns = bgLeftMaskColumns(state->rsp->fromSegmented(scaleBg.imageAddress));
+                ulx = scaleBg.frameX;
+                uly = scaleBg.frameY;
+                lrx = ulx + std::min(columns * 4, int32_t(scaleBg.frameW));
+                lry = uly + scaleBg.frameH;
+            }
+
+            ~BgLeftMaskScope() {
+                if (lrx <= ulx) {
+                    return;
+                }
+
+                RDP *rdp = state->rdp.get();
+                const uint32_t savedH = rdp->otherMode.H;
+                const uint32_t savedL = rdp->otherMode.L;
+                const uint32_t savedFill = rdp->fillColorStack[rdp->fillColorStackSize - 1];
+                rdp->setOtherMode((savedH & ~(3U << G_MDSFT_CYCLETYPE)) | G_CYC_FILL, 0);
+                rdp->setFillColor(0x00010001);
+                rdp->fillRect(ulx, uly, lrx - 1, lry - 1);
+                rdp->setFillColor(savedFill);
+                rdp->setOtherMode(savedH, savedL);
+            }
+        };
+
