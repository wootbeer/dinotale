+            // DinoTale: scroll the image in whole texels, as the N64's point-sampled RDP shows it: a fraction of a
+            // texel in the scroll doesn't move the image until it adds up to a whole one, so it's rounded down. The
+            // sprites drawn over it are rounded up (see drawObjRect), as the RDP starts a rectangle on the first
+            // pixel at or after its edge, so a sprite standing in the scenery moves in step with it. Sub-texel
+            // scrolling, or other rounding, made the two slip by a pixel against each other (wiggling edges,
+            // issue #16).
+            imageX0 = int16_t(imageX0 & ~0x1F);
+            imageY0 = int16_t(imageY0 & ~0x1F);
             int32_t imageYorig = scaleBg.imageYorig;
 
             // Keep scrolling down the image one row at a time if the 
@@ -744,6 +753,61 @@
                 y1 -= insetY;
             }
 
+            // Sprites with clamped textures are drawn on whole pixels like on the N64 (in step with the background
+            // layers, which scroll in whole texels), as a quad with the image fitted exactly between the rounded
+            // edges (the path rotated sprites use, see doObjSprite). Placing the image at the sprite's sub-pixel
+            // position inside a rectangle whose edges are rounded made edges wiggle against the image and against
+            // the backgrounds (issue #16), and strips of one image (text boxes, clouds) meet without lines.
+            // The width (and, for sprites that aren't strips, the height) is rounded once and kept, so a sprite
+            // doesn't change size by a pixel as it moves (that made 1-1's picket fence and fruit wobble). Images
+            // drawn in strips trim their edges (G_OBJRM_SHRINKSIZE); for those both vertical edges are rounded so
+            // stacked strips share them.
+            if ((objRenderMode & S2DEX_G_OBJRM_NOTXCLAMP) == 0) {
+                // Rounded up from the quarter-pixel position, as the RDP does (see bg1Cyc).
+                const float qx0 = float((int32_t(std::lround(x0 * 4.0f)) + 3) >> 2);
+                const float qx1 = qx0 + std::round(x1 - x0);
+                const float qy0 = float((int32_t(std::lround(y0 * 4.0f)) + 3) >> 2);
+                const float qy1 = (shrink > 0.0f) ? float((int32_t(std::lround(y1 * 4.0f)) + 3) >> 2) : qy0 + std::round(y1 - y0);
+                if ((qx1 <= qx0) || (qy1 <= qy0)) {
+                    return;
+                }
+
+                float s0 = shrink, s1 = o.imageW - shrink;
+                float t0 = shrink, t1 = o.imageH - shrink;
+                if (flipS) {
+                    std::swap(s0, s1);
+                }
+
+                if (flipT) {
+                    std::swap(t0, t1);
+                }
+
+                RDP::QuadOverride &quad = rdp->quadOverride;
+                const float xs[4] = { qx0, qx1, qx0, qx1 };
+                const float ys[4] = { qy0, qy0, qy1, qy1 };
+                const float ss[4] = { s0, s1, s0, s1 };
+                const float ts[4] = { t0, t0, t1, t1 };
+                for (int i = 0; i < 4; i++) {
+                    quad.pos[i][0] = xs[i];
+                    quad.pos[i][1] = ys[i];
+                    quad.tc[i][0] = ss[i];
+                    quad.tc[i][1] = ts[i];
+                }
+
+                const int32_t qulx = int32_t(qx0) * 4;
+                const int32_t quly = int32_t(qy0) * 4;
+                const int32_t qlrx = int32_t(qx1) * 4;
+                const int32_t qlry = int32_t(qy1) * 4;
+
+                // The rectangle's own texture coordinates only bound the texels it samples: the whole image.
+                const int16_t rectDsdx = int16_t(std::lround(o.imageW * 4096.0f / float(qlrx - qulx)));
+                const int16_t rectDtdy = int16_t(std::lround(o.imageH * 4096.0f / float(qlry - quly)));
+                quad.active = true;
+                rdp->drawTexRect(qulx, quly, qlrx, qlry, G_TX_RENDERTILE, 0, 0, rectDsdx, rectDtdy, false);
+                quad.active = false;
+                return;
+            }
+
             // Start the rectangle on a whole pixel and move the texture by the part of a pixel that differs,
             // so the texture lands exactly where the sprite's sub-pixel position puts it (snapping only the
             // start to a quarter pixel put the strips of one image a shimmering fraction of a pixel apart).
