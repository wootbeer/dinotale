+        if ((float(viViewRect.z) > 0.0f) && (float(viViewRect.w) > 0.0f)) {
+            const float pixelW = (bottomRightViewport.x - topLeftViewport.x) / float(viViewRect.z);
+            const float pixelH = (bottomRightViewport.y - topLeftViewport.y) / float(viViewRect.w);
+            scissor.left = std::max(scissor.left, int32_t(std::lround(topLeftViewport.x + pixelW)));
+            scissor.top = std::max(scissor.top, int32_t(std::lround(topLeftViewport.y + pixelH)));
+        }
