         bool stretchToWindow = false;
         // DinoTale: stretch S2DEX backgrounds to the full width in a wider aspect ratio.
         bool stretchBackgrounds = false;
+        // DinoTale "Expand": the game draws a wider view, so a scissor covering the whole 4:3 screen is
