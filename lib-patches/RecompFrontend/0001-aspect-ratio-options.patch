+        static std::atomic<int> pending_expand_available{ -1 };
+        static int applied_expand_available = 1;
+
+        void graphics::set_expand_available(bool available) {
+            pending_expand_available.store(available ? 1 : 0);
+        }
+
+        void graphics::apply_pending_updates() {
+            const int pending = pending_expand_available.exchange(-1);
+            if ((pending < 0) || (pending == applied_expand_available)) {
+                return;
+            }
+
+            applied_expand_available = pending;
+            recomp::config::Config &config = get_graphics_config();
+            // Enum choices are disabled by their position in the list, not their value.
+            for (uint32_t i = 0; i < aspect_ratio_options.size(); i++) {
+                if (aspect_ratio_options[i].value == static_cast<uint32_t>(ultramodern::renderer::AspectRatio::Expand)) {
+                    config.update_enum_option_disabled(graphics::options::ar_option, i, pending == 0);
+                }
+            }
+            config.update_option_description(graphics::options::ar_option, get_aspect_ratio_text(pending != 0));
+        }
+
